<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
      INTERNET lives here, not only in the debug and profile manifests the
      Flutter template ships it in. Those two exist so the tool can attach a
      debugger and hot-reload; a release build merges neither, so a release APK
      built from the template has no INTERNET permission at all.

      Every screen in this app reads Supabase. Without this line the release
      build installs, opens, draws the cached figures from Hive — and then
      every request fails, the outbox never drains and sign-in cannot complete,
      with nothing on screen saying why. It reads exactly like "the server is
      down", on a build that was never allowed to reach it.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!--
      Location, in the foreground only, for "shops near you": one fix when the
      customer taps, never a stream, never in the background. COARSE is what
      Android offers as "approximate"; FINE lets the customer choose precise,
      which a shop 400 m away needs. No ACCESS_BACKGROUND_LOCATION — the
      Kotlin app's is one of Play's most scrutinised permissions, and nothing
      here needs it.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>

    <!--
      Alerts. Android 13+ asks the customer before an app may post a
      notification; without this declared, the request cannot even be made and
      every alert zad-brain pushes is dropped on the floor, silently.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <!--
          geolocator declares a location foreground service for position
          streams. This app takes single fixes only, so the service is removed:
          it can never run, and the release manifest carries no foreground
          location service for Play to ask about.
        -->
        <service
            android:name="com.baseflow.geolocator.GeolocatorLocationService"
            tools:node="remove"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!--
          FCM shows a push with a notification block by itself while the app is
          in the background, on this channel. The id is the Kotlin app's
          (ZadFirebaseMessagingService.AGENT_CHANNEL) and the app creates it at
          start with high importance, so a background alert makes a sound and
          peeks instead of landing silently in the shade.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="zad_agent_channel" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_zad" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher: Amazon links open in the browser, not the Amazon app. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService"/>
        </intent>
    </queries>
</manifest>
