<?xml version="1.0" encoding="utf-8"?>
<!-- ZadBalanceWidget: the season row, «متاح», the day's one line, and the last three transactions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/zad_widget_background"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="14dp">
    <!-- The occasion: its badge and name on its colour, or a countdown to it.
         Hidden when the app writes no season. -->
    <LinearLayout
        android:id="@+id/widget_season"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="#FF1B4332"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/widget_season_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/widget_season_line"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="زاد"
            android:src="@drawable/ic_carrot_logo" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="متاح"
            android:textColor="#FF56635B"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/widget_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF8A968F"
            android:textSize="10sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/widget_balance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="—"
        android:textColor="#FF1B4332"
        android:textSize="24sp"
        android:textStyle="bold" />
    <!-- The daily brief's first line: the one thing that needs the customer today. -->
    <TextView
        android:id="@+id/widget_brief"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#FF56635B"
        android:textSize="12sp"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/widget_tx_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView
            android:id="@+id/widget_tx_0_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF1F2A24"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/widget_tx_0_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#FF1B4332"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_tx_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView
            android:id="@+id/widget_tx_1_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF1F2A24"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/widget_tx_1_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#FF1B4332"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_tx_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView
            android:id="@+id/widget_tx_2_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF1F2A24"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/widget_tx_2_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#FF1B4332"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="لسه مفيش معاملات"
        android:textColor="#FF8A968F"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
