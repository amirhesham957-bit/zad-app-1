<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws its own splash from these before Flutter starts. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/zad_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/zad_window_background</item>
        <!-- Kotlin's values-v29 theme: the app runs its own dark scheme, so
             Android 10+ must not invert the light one on top of it. -->
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
